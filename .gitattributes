# Normalize line endings
* text=auto

# Fortran source files
*.f    text
*.for  text
*.f90  text
*.f95  text
*.f03  text
*.f08  text

# Fortran include files
*.inc  text

# Intel Fortran project files
*.vfproj  text
*.sln     text

# Treat generated binaries as binary
*.dll binary
*.exe binary
*.lib binary
*.obj binary

# Images
*.png binary
*.jpg binary
*.gif binary